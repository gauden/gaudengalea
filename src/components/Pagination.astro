---
const { currentPage, totalPages, basePath } = Astro.props;

const prevHref = currentPage > 1 ? (currentPage === 2 ? `${basePath}/` : `${basePath}/page/${currentPage - 1}/`) : null;
const nextHref = currentPage < totalPages ? `${basePath}/page/${currentPage + 1}/` : null;
---

{
  totalPages > 1 && (
    <div class="pagination">
      {prevHref ? <a href={prevHref}>&laquo; Previous</a> : <span class="disabled">&laquo; Previous</span>}
      {" | "}
      {currentPage}
      {" | "}
      {nextHref ? <a href={nextHref}>Next &raquo;</a> : <span class="disabled">Next &raquo;</span>}
    </div>
  )
}
