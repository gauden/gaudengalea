---
import { formatDate, renderInlineMarkdown } from "../lib/site";

const { paper, fromIndex = false } = Astro.props;
const Content = paper.Content;
---

{
  fromIndex ? (
    <p style="margin-right: 4rem;">
      <a href={`/pub/${paper.id}/`}>{paper.data.title}</a>
      {" ("}
      {formatDate(paper.data.pub_date)}
      {")"}
    </p>
  ) : (
    <>
      <h1 style="margin-right: 4rem;">{paper.data.title}</h1>
      <p class="meta">
        <span set:html={renderInlineMarkdown(paper.data.author ?? "")} />
        {" "}
        {paper.data.url ? (
          <a href={paper.data.url} set:html={renderInlineMarkdown(paper.data.venue ?? "")} />
        ) : (
          <span set:html={renderInlineMarkdown(paper.data.venue ?? "")} />
        )}{" "}
        on {formatDate(paper.data.pub_date)}
      </p>
      <h3>Abstract/Excerpt</h3>
      <Content />
    </>
  )
}
