---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PaperEntry from "../../components/PaperEntry.astro";
import { getPublishedPublications } from "../../lib/content";
import { pageTitle } from "../../lib/site";

export async function getStaticPaths() {
  const entries = await getPublishedPublications();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const paper = { ...entry, Content };
---

<BaseLayout title={pageTitle(entry.data.title)} summary={entry.data.summary}>
  <PaperEntry paper={paper} />
</BaseLayout>
