---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Pagination from "../../../components/Pagination.astro";
import PaperEntry from "../../../components/PaperEntry.astro";
import { getPublishedPublications } from "../../../lib/content";
import { pageTitle } from "../../../lib/site";

export async function getStaticPaths() {
  const papers = await getPublishedPublications();
  const totalPages = Math.ceil(papers.length / 10);

  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, offset) => {
    const page = offset + 2;
    const start = (page - 1) * 10;
    return {
      params: { page: String(page) },
      props: {
        page,
        totalPages,
        papers: papers.slice(start, start + 10),
      },
    };
  });
}

const { page, totalPages, papers } = Astro.props;
---

<BaseLayout title={pageTitle("Papers")} summary="Peer-reviewed publications by Gauden Galea.">
  <h2>Papers</h2>
  <h1>Peer-Reviewed Publications</h1>
  {papers.map((paper) => <PaperEntry paper={paper} fromIndex={true} />)}
  <Pagination currentPage={page} totalPages={totalPages} basePath="/pub" />
</BaseLayout>
